# Copy to .env and fill in. Vapor loads .env from the working directory.
# Process environment variables take precedence. .env is gitignored.

# Postgres. These runtime credentials match docker-compose.yml.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=open_erp_runtime
DATABASE_PASSWORD=open_erp_runtime_local
# Migrations need the owner role:
# DATABASE_USERNAME=open_erp_owner
# DATABASE_PASSWORD=open_erp_owner_local
DATABASE_NAME=vapor_database
# Local Compose uses plaintext. Outside testing the default is require.
DATABASE_TLS_MODE=disable
# DATABASE_CA_FILE=/path/to/database-ca.pem
# DATABASE_MAX_CONNECTIONS_PER_EVENT_LOOP=4

# Trusted forwarding hops for audit client IPs. Zero uses the socket address.
TRUSTED_PROXY_COUNT=0

# trace, debug, info, notice, warning, error, or critical.
# Production defaults to notice; other environments default to info when unset.
LOG_LEVEL=info

# OIDC provider. Required when serving outside the testing environment.
# The token iss must match OIDC_ISSUER exactly. Auth0 issuers usually end with /.
# OIDC_AUDIENCE is the API identifier. The application needs the openid, email, and profile scopes.
OIDC_ISSUER=https://your-tenant.us.auth0.com/
OIDC_AUDIENCE=https://api.open-erp.local
OIDC_JWKS_URL=https://your-tenant.us.auth0.com/.well-known/jwks.json
OIDC_USERINFO_URL=https://your-tenant.us.auth0.com/userinfo
# Outside testing, the JWKS and userinfo URLs must be https unless this is true.
# OIDC_ALLOW_INSECURE_HTTP=false

# Transport security. See the README's Encryption section.
# HSTS_MAX_AGE_SECONDS=31536000
# HTTP_TLS_CERT_FILE=
# HTTP_TLS_KEY_FILE=
